# ---- LLM (셋 중 하나만 있으면 됩니다. 아무것도 없으면 오프라인 규칙 기반으로 동작) ----
# LLM_PROVIDER=auto            # auto | anthropic | openai | ollama | offline
# ANTHROPIC_API_KEY=sk-ant-...  # 절대 커밋하지 마세요
# OPENAI_API_KEY=sk-...
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_MODEL=claude-sonnet-5-5   # anthropic 기본 / openai: gpt-4o-mini / ollama: qwen2.5:7b (GTX 1060 6GB에서 4bit 실행 가능)
# LLM_MAX_TOOL_CALLS=6
# LLM_TIMEOUT=60

# ---- 데이터 경로 ----
# JEJU_DATA_DIR=./data           # 하위에 raw/ (실데이터), synthetic/ (개발용)
# JEJU_OUTPUT_DIR=./outputs

# ---- 반출 게이트 ----
# EXPORT_MIN_CELL_COUNT=5
# EXPORT_MAX_ROWS=500
