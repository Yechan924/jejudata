# ---- LLM (셋 중 하나만 있으면 됩니다. 아무것도 없으면 오프라인 규칙 기반으로 동작) ----
# LLM_PROVIDER=auto            # auto | anthropic | openai | ollama | offline
# ANTHROPIC_API_KEY=sk-ant-...  # 절대 커밋하지 마세요
# OPENAI_API_KEY=sk-...
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_MODEL=claude-sonnet-5   # anthropic 기본 / openai: gpt-4o-mini / ollama: qwen2.5:7b (GTX 1060 6GB에서 4bit 실행 가능)
# LLM_MAX_TOOL_CALLS=6
# LLM_TIMEOUT=60
# LLM_EXTRAS=followups          # 답변 후 LLM 부가 단계: followups(후속 질문 제안) · review(답변-근거 대조 자기 점검) · none. 쉼표로 복수 (호출 1회씩 추가)
# OLLAMA_NUM_CTX=12288          # Ollama 컨텍스트 길이 — 시스템 프롬프트+도구 스키마가 ~8k 토큰이라 4096 이면 잘림. VRAM 부족하면 8192

# ---- 날씨 수집 (scripts/fetch_weather.py --kma-api) ----
# KMA_API_KEY=...                # 기상청 API허브(https://apihub.kma.go.kr) 인증키. 기상청 CSV 변환·Open-Meteo 경로는 키 불필요

# ---- 제주데이터허브 공개 API (scripts/fetch_hub.py) ----
# JEJUHUB_PROJECT_KEY=...        # 허브 로그인 → 마이페이지 → 프로젝트 → 키. 절대 커밋하지 마세요

# ---- 데이터 경로 ----
# JEJU_DATA_DIR=./data           # 하위에 raw/ (실데이터), synthetic/ (개발용)
# JEJU_OUTPUT_DIR=./outputs

# ---- 반출 게이트 ----
# EXPORT_MIN_CELL_COUNT=10        # 센터 반출 정책(2026.09.01) 단순집계 10 미만 마스킹 기준
# EXPORT_MAX_ROWS=500
